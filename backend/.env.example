OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1
OPENAI_PHOTO_IMPORT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
PORT=8787

# --- Deployment hardening ---
# See backend/DEPLOY.md for the TestFlight deploy runbook and shared-token
# limits. The Docker image sets NODE_ENV=production and refuses to start
# without APP_TOKEN. Local `npm start` remains open unless you set APP_TOKEN
# or REQUIRE_APP_TOKEN=1.

# Shared app token. When set, every /api/* request must send this value in the
# x-app-token header or it gets a 401. /health stays open. Leave unset for
# local dev. This gates abuse of a public deployment; it is not a per-user
# secret. Generate one with: openssl rand -hex 24
# APP_TOKEN=

# Railway sends the real client IP in x-forwarded-for. Set this ONLY behind a
# proxy you trust (Railway); otherwise a caller can forge the header.
# TRUST_PROXY=1

# Sliding-window rate limit, applied per token+IP on /api/* routes.
# Defaults: 40 requests per 600 seconds. Set RATE_LIMIT_MAX=0 to disable.
# RATE_LIMIT_MAX=40
# RATE_LIMIT_WINDOW_SEC=600

# Aggregate ceilings for one shared app token. These make a leaked token less
# useful even when it is used from many IP addresses. Defaults: 80 total AI
# requests and 12 photo/voice imports per 600 seconds. Set either to 0 only
# for local debugging.
# SHARED_RATE_LIMIT_MAX=80
# MEDIA_RATE_LIMIT_MAX=4
# SHARED_MEDIA_RATE_LIMIT_MAX=12

# Concurrent AI requests are capped globally and per token+IP so a few slow
# calls cannot consume the small backend. Defaults: 12 total, 2 per client.
# MAX_IN_FLIGHT=12
# MAX_IN_FLIGHT_PER_KEY=2
# OPENAI_TIMEOUT_MS=60000

# Normal JSON requests are capped at 1MB; only photo/voice uploads can use the
# larger 36MB cap (413 above either limit). Photo import sends up to ~5MB PNGs
# (~6.7MB as base64) and voice import sends uncompressed WAV — OpenAI accepts
# a 25MB decoded file, ~33.4MB as base64.
# MAX_BODY_BYTES=36000000
# MAX_TEXT_BODY_BYTES=1000000
# MAX_IMAGE_BYTES=5000000
# MAX_AUDIO_BYTES=25000000
