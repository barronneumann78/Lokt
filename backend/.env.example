OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1
OPENAI_PHOTO_IMPORT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
PORT=8787

# --- Deployment hardening (all optional; unset = today's open local-dev behavior) ---
# See backend/DEPLOY.md for the full deploy runbook.

# Shared app token. When set, every /api/* request must send this value in the
# x-app-token header or it gets a 401. /health stays open. Leave unset for
# local dev. This gates abuse of a public deployment; it is not a per-user
# secret. Generate one with: openssl rand -hex 24
# APP_TOKEN=

# Sliding-window rate limit, applied per token+IP on /api/* routes.
# Defaults: 40 requests per 600 seconds. Set RATE_LIMIT_MAX=0 to disable.
# RATE_LIMIT_MAX=40
# RATE_LIMIT_WINDOW_SEC=600

# Max accepted POST body in bytes (413 above it). Default 36000000 (~36MB):
# photo import sends up to ~5MB PNGs (~6.7MB as base64) and voice import sends
# uncompressed WAV — OpenAI accepts a 25MB decoded file, ~33.4MB as base64.
# MAX_BODY_BYTES=36000000
