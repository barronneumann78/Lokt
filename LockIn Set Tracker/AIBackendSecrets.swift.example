// AIBackendSecrets.swift.example — TEMPLATE (committed; the `.example`
// extension is not compiled by Xcode).
//
// Setup — mirror of the backend/.env pattern:
//   1. Copy this file to `AIBackendSecrets.swift` in this same folder.
//      cp "AIBackendSecrets.swift.example" "AIBackendSecrets.swift"
//   2. Fill in `appToken` with the APP_TOKEN you set on the deployed backend
//      (see backend/DEPLOY.md).
//
// `AIBackendSecrets.swift` is gitignored — never commit it.
//
// Note: a token shipped inside an app binary is abuse-gating, not a true
// secret. It keeps random internet traffic off your paid backend; treat it as
// rotatable, not as a credential.

enum AIBackendSecrets {
    /// Shared app token sent as the `x-app-token` header on every backend
    /// /api/* call. Nil (or blank) sends no header.
    static let appToken: String? = nil
}
